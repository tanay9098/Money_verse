# Public Sanity settings. A project id is not a secret.
# Leave the project id blank for local demo lessons (`npm run dev` only).
# A production deployment with a blank project id shows an empty town instead of demo lessons.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-01-01

# Server-only read token. Required for private datasets and for draft-aware live updates.
# The game's public pages request published, approved content. Never prefix this with NEXT_PUBLIC_.
SANITY_API_READ_TOKEN=

# Server-only token used by `npm run seed:sanity` and by signed-in cloud progress writes.
# Create it in sanity.io/manage with Editor access. Do not expose it to the browser.
# Cloud progress is stored as an unpublished draft. A public dataset still cannot read it
# without this token. Do not publish playerProgress documents.
SANITY_API_WRITE_TOKEN=

# Google sign-in (Auth.js / next-auth). All three are server-only. Never prefix them with NEXT_PUBLIC_.
# Leave them blank to keep the guest game. Sign-in stays disabled until they are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Generate with: npx auth secret   or   openssl rand -base64 32
AUTH_SECRET=
# Canonical origin used for the OAuth callback. No trailing slash.
# Local: http://localhost:3000
# Production: https://your-domain.example
AUTH_URL=
# Optional. Auth.js already trusts the host when AUTH_URL is set, on Vercel, or outside production.
# Set this only when the public host changes and AUTH_URL is not a single canonical origin.
AUTH_TRUST_HOST=
